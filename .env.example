# ==============================================================================
# JAY MANGE PORTFOLIO - DIRECT CLIENT EMAIL CONFIGURATION
# ==============================================================================

# OPTION 1: EmailJS (@emailjs/browser) - Direct Background Email Sending Library
# Get your free credentials from https://dashboard.emailjs.com/
# 1. Add Email Service (e.g. Gmail) -> Copy Service ID
# 2. Create Email Template -> Copy Template ID
# 3. Account Settings -> Copy Public Key
VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# OPTION 2: Web3Forms (Alternative)
# Get a free key at https://web3forms.com/
# VITE_WEB3FORMS_KEY=your_web3forms_key_here
